diff --git a/hermes_cli/plugins_service_tier.py b/hermes_cli/plugins_service_tier.py
new file mode 100644
index 0000000000..2749695952
--- /dev/null
+++ b/hermes_cli/plugins_service_tier.py
@@ -0,0 +1,22 @@
+"""Registration for required, profile-selected service-tier consumption policy."""
+
+from hermes_cli.plugins_loader import _serialized_replacement
+
+
+class ServiceTierPluginContextMixin:
+    @_serialized_replacement
+    def register_service_tier_policy(self, name, callback):
+        """Receive an immutable ServiceTierRequest; return None, normal or priority."""
+        if not isinstance(name, str) or not name.strip() or not callable(callback):
+            raise ValueError("A service-tier policy requires a name and callback")
+        if not hasattr(self._manager, "_service_tier_policies"):
+            self._manager._service_tier_policies = {}
+        key = self.plugin_id + ":" + name
+        return self._register_entry(
+            "service_tier_policy",
+            key,
+            self._manager._service_tier_policies,
+            callback,
+            "Plugin %s registered service-tier policy: %s",
+            key,
+        )
