diff --git a/agent/service_tier_policy.py b/agent/service_tier_policy.py
new file mode 100644
index 0000000000..3e3c4519a1
--- /dev/null
+++ b/agent/service_tier_policy.py
@@ -0,0 +1,225 @@
+"""Opt-in tier consumption, independent of captured provider/model routing."""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from pathlib import Path
+from threading import Event
+
+
+class ServiceTierPolicyError(RuntimeError):
+    """A required consumption policy is unavailable; execution must stop."""
+
+
+@dataclass(frozen=True)
+class RequestOrigin:
+    profile_home: Path
+    kind: str = ""
+    message: str = ""
+    identity: str = ""
+    job_name: str = ""
+
+
+@dataclass(frozen=True)
+class ServiceTierRequest:
+    origin: RequestOrigin
+    platform: str
+    session_id: str
+    provider: str
+    model: str
+    api_mode: str
+    base_url: str
+
+
+@dataclass(frozen=True)
+class _OriginBinding:
+    origin: RequestOrigin
+    guard: object
+    revoked: Event
+
+    def check(self):
+        try:
+            if self.revoked.is_set():
+                raise ValueError("Expired scope")
+            if self.guard is not None:
+                self.guard()
+        except Exception:
+            raise ServiceTierPolicyError(
+                "Service-tier consumer ownership expired"
+            ) from None
+
+
+_ORIGIN = ContextVar("service_tier_origin", default=None)
+
+
+@contextmanager
+def request_origin_scope(*, kind, message="", identity="", job_name="", guard=None):
+    from hermes_constants import get_hermes_home
+
+    origin = RequestOrigin(get_hermes_home(), kind, message, identity, job_name)
+    binding = _OriginBinding(origin, guard, Event())
+    token = _ORIGIN.set(binding)
+    try:
+        yield origin
+    finally:
+        binding.revoked.set()
+        _ORIGIN.reset(token)
+
+
+def capture_request_owner(agent, *, kind, identity="", job_name=""):
+    """Queued agents own their consumer/profile, not an inherited foreground exemption."""
+    from hermes_constants import get_hermes_home
+
+    agent._service_tier_owner = RequestOrigin(
+        get_hermes_home(), kind, "", identity, job_name
+    )
+
+
+def _selected_policy(home):
+    from utils import fast_safe_load
+    from hermes_cli.plugins import get_plugin_manager
+
+    try:
+        path = home / "config.yaml"
+        try:
+            with path.open(encoding="utf-8") as stream:
+                config = fast_safe_load(stream)
+        except FileNotFoundError:
+            config = {}
+        if config is None:
+            config = {}
+        if not isinstance(config, dict):
+            raise ValueError("Invalid profile config")
+        key = config.get("service_tier_policy")
+        if key is None:
+            return None
+        if not isinstance(key, str) or not key.strip():
+            raise ValueError("Invalid policy selection")
+        manager = get_plugin_manager()
+        manager.discover_and_load()
+        callback = getattr(manager, "_service_tier_policies", {}).get(key)
+        if not callable(callback):
+            raise ValueError("Missing selected policy")
+        return key, callback, manager
+    except Exception:
+        raise ServiceTierPolicyError(
+            "Required service-tier policy is unavailable"
+        ) from None
+
+
+@dataclass(frozen=True)
+class _Decision:
+    request: ServiceTierRequest
+    key: str
+    callback: object
+    manager: object
+    tier: str | None
+    owner: _OriginBinding | None
+
+    def check(self):
+        if self.owner is not None:
+            self.owner.check()
+        from hermes_constants import get_hermes_home
+
+        if (
+            get_hermes_home() != self.request.origin.profile_home
+            or getattr(self.manager, "_service_tier_policies", {}).get(self.key)
+            is not self.callback
+        ):
+            raise ServiceTierPolicyError("Service-tier policy ownership expired")
+
+
+def begin_turn(agent):
+    from hermes_constants import get_hermes_home
+
+    home = get_hermes_home()
+    agent._service_tier_decision = None
+    captured = getattr(agent, "_service_tier_owner", None)
+    owner = None if captured is not None else _ORIGIN.get()
+    origin = captured or (owner.origin if owner is not None else RequestOrigin(home))
+    selected = _selected_policy(home)
+    if selected is None:
+        if (
+            type(origin) is RequestOrigin
+            and origin.profile_home != home
+            and _selected_policy(origin.profile_home) is not None
+        ):
+            raise ServiceTierPolicyError("Service-tier policy profile mismatch")
+        return
+    if type(origin) is not RequestOrigin or origin.profile_home != home:
+        raise ServiceTierPolicyError("Service-tier policy profile mismatch")
+    if owner is not None:
+        owner.check()
+    request = ServiceTierRequest(
+        origin,
+        str(getattr(agent, "platform", "") or ""),
+        str(getattr(agent, "session_id", "") or ""),
+        str(agent.provider or ""),
+        str(agent.model or ""),
+        str(agent.api_mode or ""),
+        str(agent.base_url or ""),
+    )
+    key, callback, manager = selected
+    try:
+        result = callback(request)
+    except Exception:
+        raise ServiceTierPolicyError("Required service-tier policy failed") from None
+    if result is not None and (
+        type(result) is not str or result not in ("normal", "priority")
+    ):
+        raise ServiceTierPolicyError("Invalid service-tier policy result")
+    decision = _Decision(request, key, callback, manager, result, owner)
+    decision.check()
+    agent._service_tier_decision = decision
+
+
+def apply_tier(agent, overrides):
+    decision = getattr(agent, "_service_tier_decision", None)
+    if not isinstance(decision, _Decision):
+        return overrides
+    decision.check()
+    request = decision.request
+    if (
+        agent.provider, agent.model, agent.api_mode, agent.base_url,
+    ) != (request.provider, request.model, request.api_mode, request.base_url):
+        # A fallback is a new route, not permission to reuse stale tier kwargs.
+        # Preserve this agent's original request owner across nested contexts.
+        token = _ORIGIN.set(decision.owner)
+        try:
+            begin_turn(agent)
+        finally:
+            _ORIGIN.reset(token)
+        decision = getattr(agent, "_service_tier_decision", None)
+        if not isinstance(decision, _Decision):
+            return overrides
+        decision.check()
+        request = decision.request
+        if (agent.provider, agent.model, agent.api_mode, agent.base_url) != (
+            request.provider, request.model, request.api_mode, request.base_url
+        ):
+            raise ServiceTierPolicyError("Route changed during tier policy evaluation")
+    if decision.tier is None:
+        return overrides
+    if "model" in overrides and overrides["model"] != request.model:
+        raise ServiceTierPolicyError("Wire model changed after the tier decision")
+    body = overrides.get("extra_body")
+    if isinstance(body, dict) and "model" in body and body["model"] != request.model:
+        raise ServiceTierPolicyError("Wire model changed after the tier decision")
+    from hermes_cli.models import resolve_fast_mode_overrides
+
+    fast = resolve_fast_mode_overrides(
+        agent.model, provider=agent.provider, base_url=agent.base_url
+    )
+    if not fast:
+        raise ServiceTierPolicyError("Selected route does not support a tier policy")
+    result = dict(overrides)
+    for key in ("service_tier", "speed"):
+        result.pop(key, None)
+    if isinstance(result.get("extra_body"), dict):
+        body = dict(result["extra_body"])
+        for key in ("service_tier", "speed"):
+            body.pop(key, None)
+        result["extra_body"] = body
+    if decision.tier == "priority":
+        result.update(fast)
+    return result
