         logger.debug("Plugin %s registered %d redaction pattern(s)", self.manifest.name, count)
         return count
 
+    def register_required_tool_policy(self, callback: Callable):
+        """Lease an opt-in task-local policy independent of optional hooks.
+
+        Bind the returned object's ``scope()`` around the entire trusted worker
+        execution. Unload revokes the captured generation; reload cannot revive
+        old scopes. Validators return literal True to admit, otherwise deny.
+        """
+        from agent.required_tool_policy import RequiredToolPolicy
+
+        policy = RequiredToolPolicy(callback)
+        self._track(
+            "required_tool_policy",
+            getattr(callback, "__name__", "policy"),
+            policy.revoke,
+        )
+        return policy
     def register_hook(self, hook_name: str, callback: Callable) -> PluginRegistration:
         """Register a lifecycle hook callback (unknown names warn but are still stored)."""
         return self._track_callback("hook", hook_name, callback, self._manager._hooks, VALID_HOOKS)
