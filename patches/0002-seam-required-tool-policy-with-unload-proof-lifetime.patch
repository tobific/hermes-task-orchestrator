new file mode 100644
index 0000000000..9a95dd9adf
--- /dev/null
+++ b/agent/required_tool_policy.py
@@ -0,0 +1,76 @@
+"""Opt-in task-local tool policy leases, independent of optional hook lookup.
+
+A captured scope retains every required policy until it exits. Revocation is
+shared across copied thread contexts and never turns a required scope into an
+unrestricted one. Already admitted effects may finish; subsequent admissions
+fail closed. This is cooperative host dispatch policy, not a Python sandbox.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+import inspect
+from threading import Event
+from types import MappingProxyType
+from typing import Callable, Iterator, Mapping
+
+_REQUIRED: ContextVar[tuple["RequiredToolPolicy", ...]] = ContextVar(
+    "required_tool_policies", default=()
+)
+_DENIED = "Required tool policy denied this invocation"
+
+
+class RequiredToolPolicy:
+    """One registration generation. Unloading revokes this exact object."""
+
+    def __init__(self, check: Callable[[str, Mapping], bool]):
+        if not callable(check) or inspect.iscoroutinefunction(check):
+            raise TypeError("Required tool policy must be a synchronous callable")
+        self._check = check
+        self._revoked = Event()
+
+    def revoke(self) -> None:
+        self._revoked.set()
+
+    @contextmanager
+    def scope(self) -> Iterator[None]:
+        # Conjunction, never replacement: a nested generation cannot erase its
+        # parent's lifetime constraint, including an already revoked parent.
+        token = _REQUIRED.set(_REQUIRED.get() + (self,))
+        try:
+            yield
+        finally:
+            _REQUIRED.reset(token)
+
+
+def required_policy_error(name: str, args: dict) -> str | None:
+    """Check the captured generations, never a current plugin-name lookup.
+
+    Call at ingress and again immediately before handler admission, after all
+    ordinary argument rewriting. Validators must be bounded and side-effect-free.
+    Give each validator a detached argument view so it cannot rewrite the call.
+    """
+    policies = _REQUIRED.get()
+    if not policies:
+        return None
+    try:
+        for policy in policies:
+            if policy._revoked.is_set():
+                return _DENIED
+            result = policy._check(name, MappingProxyType(deepcopy(args)))
+            if inspect.isawaitable(result):
+                close = getattr(result, "close", None)
+                if callable(close):
+                    close()
+                return _DENIED
+            if result is not True or policy._revoked.is_set():
+                return _DENIED
+        # A later validator may revoke an earlier one. All captured generations
+        # must still be live at this admission's final check.
+        if any(policy._revoked.is_set() for policy in policies):
+            return _DENIED
+    except Exception:
+        return _DENIED
+    return None
