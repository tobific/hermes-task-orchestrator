+def _native_notice_marker(marker, delegation_id):
+    return (
+        isinstance(marker, dict)
+        and set(marker) == {"native_terminal_notice", "delegation_id"}
+        and type(marker.get("native_terminal_notice")) is int
+        and marker["native_terminal_notice"] == 1
+        and marker.get("delegation_id") == delegation_id
+    )
+
+
+def _native_notice_fields():
+    return {
+        "type",
+        "delegation_id",
+        "session_key",
+        "origin_ui_session_id",
+        "origin_session_id",
+        "parent_session_id",
+        "goal",
+        "goals",
+        "context",
+        "toolsets",
+        "role",
+        "model",
+        "is_batch",
+        "status",
+        "dispatched_at",
+        "completed_at",
+    } | set(_ROUTING_KEYS)
+
+
+def _native_notice_error(status):
+    return f"Guarded delegation ended with native status {status}; no worker output was delivered. Inspect its durable result for details."
+
+
+def _as_native_notice(event):
+    notice = {k: v for k, v in event.items() if k in _native_notice_fields()}
+    notice.update(
+        summary=None,
+        error=_native_notice_error(event["status"]),
+        completion_fence={
+            "native_terminal_notice": 1,
+            "delegation_id": event["delegation_id"],
+        },
+    )
+    if event.get("is_batch"):
+        notice["results"] = []
+    return notice
+
+
+def _is_native_notice_event(event, delegation_id):
+    return (
+        isinstance(event, dict)
+        and event.get("delegation_id") == delegation_id
+        and _native_notice_marker(event.get("completion_fence"), delegation_id)
+        and event.get("status") in {"error", "stalled", "unknown"}
+        and event.get("summary") is None
+        and event.get("results", []) == []
+        and event.get("error") == _native_notice_error(event["status"])
+        and set(event)
+        <= _native_notice_fields()
+        | {"completion_fence", "summary", "error", "results", "restored"}
+    )
+
