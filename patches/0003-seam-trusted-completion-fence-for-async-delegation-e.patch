 # ── Stale-delegation detection (progress-based, on by default) ──────────────
+# Optional host-owned completion fence. The default is deliberately absent:
+# callers which never register a fence retain the legacy missing-row behavior.
+# A context-local value is captured by a dispatch record, while the process
+# default lets a host plugin validate rows restored or claimed after restart.
+_completion_guard_var: ContextVar[Any] = ContextVar(
+    "async_completion_guard", default=None
+)
+_completion_guard_lock = threading.RLock()
+_completion_guard_default: Any = None
+
+
+class _CompletionGuardRegistration:
+    """Context manager used by host integrations to register a fence provider."""
+
+    def __init__(self, provider: Any):
+        self.provider = provider
+        self._token = None
+
+    def __enter__(self):
+        self._token = _completion_guard_var.set(self.provider)
+        return self.provider
+
+    def __exit__(self, exc_type, exc_value, traceback):
+        _completion_guard_var.reset(self._token)
+        return False
+
+
+def register_completion_guard(provider: Any) -> _CompletionGuardRegistration:
+    """Return a context manager for a host-owned completion fence provider.
+
+    A provider must expose ``lock`` (a reentrant durable-lock context manager),
+    ``stamp`` and ``validate``. Validation is never consulted for unmarked
+    legacy events.
+    """
+    if provider is not None and not all(
+        callable(getattr(provider, name, None))
+        for name in ("lock", "stamp", "validate")
+    ):
+        raise TypeError("completion guard must provide lock, stamp and validate")
+    return _CompletionGuardRegistration(provider)
+
+
+def set_completion_guard(provider: Any) -> None:
+    """Install a live provider for this profile, never an identifier history."""
+    if provider is not None and not all(
+        callable(getattr(provider, n, None)) for n in ("lock", "validate")
+    ):
+        raise TypeError("completion guard must provide lock and validate")
+    from hermes_constants import get_hermes_home
+
+    key = str(get_hermes_home().resolve())
+    global _completion_guard_default
+    with _completion_guard_lock:
+        if not isinstance(_completion_guard_default, dict):
+            _completion_guard_default = {}
+        if provider is None:
+            _completion_guard_default.pop(key, None)
+        else:
+            _completion_guard_default[key] = provider
+
+
+def _completion_guard_for(record: Optional[Dict[str, Any]] = None) -> Any:
+    if record is not None:
+        return record.get("_completion_guard")
+    current = _completion_guard_var.get()
+    if current is not None:
+        return current
+    from hermes_constants import get_hermes_home
+
+    key = str(get_hermes_home().resolve())
+    with _completion_guard_lock:
+        return (_completion_guard_default or {}).get(key)
+
+
+def _completion_guard_context(provider: Any):
+    if provider is None:
+        return nullcontext()
+    context = provider.lock()
+    if not hasattr(context, "__enter__") or not hasattr(context, "__exit__"):
+        raise TypeError("completion guard lock must return a context manager")
+    return context
+
+
+def _guard_validate(provider: Any, marker: Any, delegation_id: str) -> Optional[bool]:
+    if provider is None:
+        return None
+    if not isinstance(marker, dict):
+        return False
+    try:
+        return provider.validate(marker, delegation_id) is True
+    except Exception:
+        logger.warning(
+            "Async completion fence validation unavailable for %s",
+            delegation_id,
+            exc_info=True,
+        )
+        return None
+
+
+def _guard_stamp(provider: Any, record: Dict[str, Any]) -> Optional[Dict[str, Any]]:
+    if provider is None:
+        return None
+    marker = provider.stamp(record)
+    if not isinstance(marker, dict):
+        raise TypeError("completion guard stamp must return an object")
+    return marker
+
+
+def _guard_prepare(provider: Any, marker: Dict[str, Any], delegation_id: str):
+    """Give a provider one chance to add its current review snapshot."""
+    prepare = getattr(provider, "prepare", None)
+    if not callable(prepare):
+        return marker
+    try:
+        prepared = prepare(marker, delegation_id)
+    except Exception:
+        logger.warning(
+            "Async completion fence preparation failed for %s",
+            delegation_id,
+            exc_info=True,
+        )
+        return None
+    if prepared is None or not isinstance(prepared, dict):
+        return None
+    return prepared
+
+
