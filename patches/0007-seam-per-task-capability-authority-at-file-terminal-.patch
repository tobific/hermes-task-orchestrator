+def get_delegation_identity() -> DelegationIdentity:
+    """Return immutable task/run/write ownership for the active child."""
+    return _DELEGATION_IDENTITY.get()
+
+
+@contextmanager
+def delegated_file_effect_context() -> Iterator[None]:
+    """Allow internal file-tool subprocesses after their target was authorized."""
+    token = _DELEGATED_FILE_EFFECT.set(True)
+    try:
+        yield
+    finally:
+        _DELEGATED_FILE_EFFECT.reset(token)
+
+
+class DelegationScopeError(PermissionError):
+    """An adaptive worker attempted an effect outside its trusted packet."""
+
+
+def authorize_delegated_tool(tool_name: str) -> None:
+    """Enforce the packet capability at dispatch, not merely in its schema."""
+    identity = get_delegation_identity()
+    if not identity.run_id:
+        return
+    from tools.delegation_contracts import CAPABILITY_TOOL_ALLOWLISTS, CapabilityProfile
+
+    try:
+        allowed = CAPABILITY_TOOL_ALLOWLISTS[CapabilityProfile(identity.capability_profile)]
+    except (ValueError, KeyError):
+        allowed = frozenset()
+    if not isinstance(tool_name, str) or tool_name not in allowed:
+        raise DelegationScopeError(
+            f"Tool {tool_name!r} is not authorized for {identity.capability_profile!r}. "
+            "Do not retry or use GUI/browser/MCP alternatives. Return needs_parent_decision "
+            "with completed work and the required parent-run action."
+        )
+
+
+def _contains_path(scope: str, target: str | Path) -> bool:
+    scope_path = Path(scope).expanduser().resolve(strict=False)
+    target_path = Path(target).expanduser().resolve(strict=False)
+    try:
+        return os.path.commonpath((str(scope_path), str(target_path))) == str(
+            scope_path
+        )
+    except ValueError:
+        return False
+
+
+def authorize_delegated_write(path: str | Path) -> None:
+    """Authorize one concrete file target for a trusted adaptive worker."""
+
+    identity = get_delegation_identity()
+    if not identity.run_id:
+        return
+    if identity.capability_profile != "workspace-write":
+        raise DelegationScopeError(
+            f"capability profile {identity.capability_profile!r} cannot mutate files"
+        )
+    if not identity.write_owner_token or not identity.write_scope:
+        raise DelegationScopeError("adaptive write requires an owned write scope")
+    if not any(_contains_path(scope, path) for scope in identity.write_scope):
+        raise DelegationScopeError(
+            f"write target is outside the delegated scope: {Path(path)}"
+        )
+
+
+def authorize_delegated_terminal(
+    command: str, *, cwd: str | Path, background: bool = False
+) -> None:
+    """Deny adaptive terminal use unless a real execution sandbox is installed.
+
+    The local terminal ultimately executes through a shell, so token/path
+    classification cannot prove nested or expansion-time effects. Adaptive
+    packets therefore receive no terminal authority. Host-owned file tools may
+    still use their narrowly scoped internal subprocess lane after authorizing
+    the concrete file target.
+    """
+
+    identity = get_delegation_identity()
+    if not identity.run_id:
+        return
+    if _DELEGATED_FILE_EFFECT.get():
+        return
+    raise DelegationScopeError(
+        "adaptive terminal is disabled because no verified OS execution sandbox is installed"
+    )
