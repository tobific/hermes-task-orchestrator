+"""Pure contracts and state-machine rules for adaptive delegation."""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass, field, is_dataclass
+from enum import Enum
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+from typing import Any, Iterable, Mapping, Sequence
+
+
+DEFAULT_MAX_RESULT_CHARS = 14_000
+
+
+class ContractError(ValueError):
+    pass
+
+
+_TASK_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
+
+
+class _ValueEnum(str, Enum):
+    def __str__(self) -> str:
+        return self.value
+
+
+class TaskKind(_ValueEnum):
+    INSPECT = "inspect"
+    RESEARCH = "research"
+    EXTRACT = "extract"
+    EXECUTE = "execute"
+    EDIT = "edit"
+    TEST = "test"
+    REVIEW = "review"
+    SUMMARIZE = "summarize"
+
+
+class Effort(_ValueEnum):
+    AUTO = "auto"
+    LOW = "low"
+    MEDIUM = "medium"
+    HIGH = "high"
+    XHIGH = "xhigh"
+    MAX = "max"
+
+
+class Speed(_ValueEnum):
+    AUTO = "auto"
+    STANDARD = "standard"
+    FAST = "fast"
+
+
+class Priority(_ValueEnum):
+    CRITICAL = "critical"
+    SUPPORT = "support"
+    BACKGROUND = "background"
+
+
+class CapabilityProfile(_ValueEnum):
+    NONE = "none"
+    READ_ONLY = "read-only"
+    WEB_READ = "web-read"
+    CODE_READ = "code-read"
+    CODE_READ_TEST = "code-read-test"
+    WORKSPACE_WRITE = "workspace-write"
+    COMPUTER_USE = "computer-use"
+
+
+class TaskState(_ValueEnum):
+    BLOCKED = "blocked"
+    READY = "ready"
+    RUNNING = "running"
+    SUCCEEDED = "succeeded"
+    FAILED = "failed"
+    CANCELLED = "cancelled"
+    EXPIRED = "expired"
+    SUPERSEDED = "superseded"
+    ABANDONED = "abandoned"
+    INTERRUPTED = "interrupted"
+
+
+class RunState(_ValueEnum):
+    OPEN = "open"
+    JOINING = "joining"
+    COMPLETE = "complete"
+    PARTIAL = "partial"
+    FAILED = "failed"
+    CANCELLED = "cancelled"
+    ABANDONED = "abandoned"
+    INTERRUPTED = "interrupted"
+
+
+class HostExecutionStatus(_ValueEnum):
+    COMPLETED = "completed"
+    ERROR = "error"
+    TIMEOUT = "timeout"
+    CANCELLED = "cancelled"
+    INTERRUPTED = "interrupted"
+    ABANDONED = "abandoned"
+
+
+class WorkerStatus(_ValueEnum):
+    PASS = "pass"
+    NEEDS_PARENT_DECISION = "needs_parent_decision"
+    RETRYABLE_FAILURE = "retryable_failure"
+    TERMINAL_FAILURE = "terminal_failure"
+
+
+TERMINAL_TASK_STATES = frozenset({
+    TaskState.SUCCEEDED,
+    TaskState.FAILED,
+    TaskState.CANCELLED,
+    TaskState.EXPIRED,
+    TaskState.SUPERSEDED,
+    TaskState.ABANDONED,
+    TaskState.INTERRUPTED,
+})
+
+TERMINAL_RUN_STATES = frozenset({
+    RunState.COMPLETE,
+    RunState.FAILED,
+    RunState.CANCELLED,
+    RunState.ABANDONED,
+    RunState.INTERRUPTED,
+})
+
+_TASK_TRANSITIONS = {
+    TaskState.BLOCKED: {
+        TaskState.READY,
+        # Dependency resolution can terminalize a task before it is ever
+        # runnable (unknown dependency or a dependency that did not succeed).
+        TaskState.FAILED,
+        TaskState.CANCELLED,
+        TaskState.SUPERSEDED,
+        TaskState.ABANDONED,
+    },
+    TaskState.READY: {
+        TaskState.RUNNING,
+        TaskState.CANCELLED,
+        TaskState.EXPIRED,
+        TaskState.SUPERSEDED,
+        TaskState.ABANDONED,
+    },
+    TaskState.RUNNING: {
+        TaskState.SUCCEEDED,
+        TaskState.FAILED,
+        TaskState.CANCELLED,
+        TaskState.EXPIRED,
+        TaskState.SUPERSEDED,
+        TaskState.ABANDONED,
+        TaskState.INTERRUPTED,
+    },
+}
+_RUN_TRANSITIONS = {
+    RunState.OPEN: {
+        RunState.JOINING,
+        RunState.COMPLETE,
+        RunState.PARTIAL,
+        RunState.FAILED,
+        RunState.CANCELLED,
+        RunState.ABANDONED,
+        RunState.INTERRUPTED,
+    },
+    RunState.JOINING: {
+        RunState.OPEN,
+        RunState.COMPLETE,
+        RunState.PARTIAL,
+        RunState.FAILED,
+        RunState.CANCELLED,
+        RunState.ABANDONED,
+        RunState.INTERRUPTED,
+    },
+    # A partial run can still finish after optional/remaining work completes.
+    RunState.PARTIAL: {
+        RunState.OPEN,
+        RunState.COMPLETE,
+        RunState.FAILED,
+        RunState.CANCELLED,
+        RunState.ABANDONED,
+        RunState.INTERRUPTED,
+    },
+    # A failed run may be explicitly reopened only by a parent-authorized supersede.
+    RunState.FAILED: {
+        RunState.OPEN,
+    },
+}
+
+
+def validate_task_transition(before: TaskState, after: TaskState) -> None:
+    if before == after:
+        return
+    if after not in _TASK_TRANSITIONS.get(before, set()):
+        raise ContractError(f"invalid task transition: {before.value} -> {after.value}")
+
+
+def validate_run_transition(before: RunState, after: RunState) -> None:
+    if before == after:
+        return
+    if after not in _RUN_TRANSITIONS.get(before, set()):
+        raise ContractError(f"invalid run transition: {before.value} -> {after.value}")
+
+
+def host_status_to_task_state(status: HostExecutionStatus) -> TaskState:
+    return {
+        HostExecutionStatus.COMPLETED: TaskState.SUCCEEDED,
+        HostExecutionStatus.ERROR: TaskState.FAILED,
+        HostExecutionStatus.TIMEOUT: TaskState.EXPIRED,
+        HostExecutionStatus.CANCELLED: TaskState.CANCELLED,
+        HostExecutionStatus.INTERRUPTED: TaskState.INTERRUPTED,
+        HostExecutionStatus.ABANDONED: TaskState.ABANDONED,
+    }[status]
+
+
+def _json_value(value: Any) -> Any:
+    if isinstance(value, Enum):
+        return value.value
+    if is_dataclass(value):
+        return {key: _json_value(item) for key, item in asdict(value).items()}
+    if isinstance(value, Mapping):
+        return {str(key): _json_value(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list, set, frozenset)):
+        return [_json_value(item) for item in value]
+    return value
+
+
+def stable_json_dumps(value: Any) -> str:
+    return json.dumps(
+        _json_value(value), sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    )
+
+
+def _enum(enum_type: type[_ValueEnum], value: Any, default: _ValueEnum) -> _ValueEnum:
+    raw = str(value or default.value).strip().lower()
+    try:
+        return enum_type(raw)
+    except ValueError as exc:
+        allowed = ", ".join(item.value for item in enum_type)
+        raise ContractError(
+            f"invalid {enum_type.__name__}: {raw!r}; expected {allowed}"
+        ) from exc
+
+
+def _boolean(value: Mapping[str, Any], name: str, default: bool) -> bool:
+    if name not in value:
+        return default
+    parsed = value[name]
+    if not isinstance(parsed, bool):
+        raise ContractError(f"task {name} must be a boolean")
+    return parsed
+
+
+def canonical_scope(path: str) -> str:
+    raw = os.path.expanduser(str(path or "").strip())
+    if not raw:
+        raise ContractError("write_scope entries must be non-empty paths")
+    return os.path.normcase(os.path.realpath(os.path.abspath(raw)))
+
+
+def scopes_overlap(left: str, right: str) -> bool:
+    a, b = canonical_scope(left), canonical_scope(right)
+    try:
+        return os.path.commonpath((a, b)) in {a, b}
+    except ValueError:
+        return False
+
+
+def write_scopes_overlap(left: Iterable[str], right: Iterable[str]) -> bool:
+    return any(scopes_overlap(a, b) for a in left for b in right)
+
+
+CAPABILITY_TOOL_ALLOWLISTS: Mapping[CapabilityProfile, frozenset[str]] = {
+    CapabilityProfile.NONE: frozenset(),
+    CapabilityProfile.READ_ONLY: frozenset({"read_file", "search_files"}),
+    CapabilityProfile.WEB_READ: frozenset({"web_search", "web_extract"}),
+    CapabilityProfile.CODE_READ: frozenset({"read_file", "search_files"}),
+    CapabilityProfile.CODE_READ_TEST: frozenset({
+        "read_file",
+        "search_files",
+    }),
+    CapabilityProfile.WORKSPACE_WRITE: frozenset({
+        "read_file",
+        "search_files",
+        "write_file",
+        "patch",
+    }),
+    CapabilityProfile.COMPUTER_USE: frozenset({"computer_use"}),
+}
+
+
+@dataclass(frozen=True)
+class TaskSpec:
+    id: str
+    goal: str
+    context: str = ""
+    kind: TaskKind = TaskKind.INSPECT
+    effort: Effort = Effort.AUTO
+    speed: Speed = Speed.AUTO
+    priority: Priority = Priority.SUPPORT
+    required: bool = True
+    depends_on: tuple[str, ...] = ()
+    acceptance: str = ""
+    evidence_scope: str = ""
+    capability_profile: CapabilityProfile = CapabilityProfile.READ_ONLY
+    write_scope: tuple[str, ...] = ()
+    deadline_seconds: int = 300
+    dedupe_key: str = ""
+    idempotent: bool = True
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any], *, index: int = 0) -> "TaskSpec":
+        if not isinstance(value, Mapping):
+            raise ContractError("task must be an object")
+        goal = str(value.get("goal") or "").strip()
+        if not goal:
+            raise ContractError("task goal is required")
+        explicit_id = str(value.get("id") or "").strip()
+        if explicit_id:
+            if not _TASK_ID_RE.fullmatch(explicit_id):
+                raise ContractError(
+                    "task id must be 1-64 ASCII letters, digits, dot, underscore, or hyphen"
+                )
+            task_id = explicit_id
+        else:
+            identity = stable_json_dumps({
+                key: item for key, item in value.items() if key != "id"
+            })
+            digest = hashlib.sha256(f"{index}:{identity}".encode("utf-8")).hexdigest()[
+                :12
+            ]
+            task_id = f"task-{digest}"
+        raw_depends = value.get("depends_on") or ()
+        if isinstance(raw_depends, (str, bytes)) or not isinstance(
+            raw_depends, Sequence
+        ):
+            raise ContractError(f"task {task_id!r} depends_on must be an array")
+        depends = tuple(str(item).strip() for item in raw_depends)
+        if any(not item for item in depends):
+            raise ContractError(f"task {task_id!r} has an empty dependency")
+        scope_values = value.get("write_scope") or ()
+        if isinstance(scope_values, (str, bytes)) or not isinstance(
+            scope_values, Sequence
+        ):
+            raise ContractError(f"task {task_id!r} write_scope must be an array")
+        raw_scopes = tuple(canonical_scope(item) for item in scope_values)
+        deadline = value.get("deadline_seconds", 300)
+        if (
+            isinstance(deadline, bool)
+            or not isinstance(deadline, int)
+            or not 1 <= deadline <= 86400
+        ):
+            raise ContractError(
+                f"task {task_id!r} deadline_seconds must be in [1, 86400]"
+            )
+        profile = _enum(
+            CapabilityProfile,
+            value.get("capability_profile"),
+            CapabilityProfile.READ_ONLY,
+        )
+        if raw_scopes and profile is not CapabilityProfile.WORKSPACE_WRITE:
+            raise ContractError(
+                f"task {task_id!r} declares write_scope without workspace-write capability"
+            )
+        if profile is CapabilityProfile.WORKSPACE_WRITE and not raw_scopes:
+            raise ContractError(
+                f"task {task_id!r} workspace-write capability requires a non-empty write_scope"
+            )
+        return cls(
+            id=task_id,
+            goal=goal,
+            context=str(value.get("context") or ""),
+            kind=_enum(TaskKind, value.get("kind"), TaskKind.INSPECT),
+            effort=_enum(Effort, value.get("effort"), Effort.AUTO),
+            speed=_enum(Speed, value.get("speed"), Speed.AUTO),
+            priority=_enum(Priority, value.get("priority"), Priority.SUPPORT),
+            required=_boolean(value, "required", True),
+            depends_on=depends,
+            acceptance=str(value.get("acceptance") or ""),
+            evidence_scope=str(value.get("evidence_scope") or "").strip(),
+            capability_profile=profile,
+            write_scope=raw_scopes,
+            deadline_seconds=deadline,
+            dedupe_key=str(value.get("dedupe_key") or "").strip(),
+            idempotent=_boolean(value, "idempotent", True),
+        )
+
+
+@dataclass(frozen=True)
+class RoutePin:
+    provider: str = "openai-codex"
+    model: str = "gpt-6-luna"
+    base_url: str = "https://chatgpt.com/backend-api/codex"
+    api_mode: str = "codex_responses"
+    allow_fallbacks: bool = False
+
+
+@dataclass(frozen=True)
+class TaskPacket:
+    run_id: str
+    task_id: str
+    generation: int
+    parent_session_id: str
+    parent_turn_id: str
+    objective: str
+    context: str
+    acceptance: str
+    dependencies: tuple[str, ...]
+    required: bool
+    kind: TaskKind
+    effort: Effort
+    speed: Speed
+    priority: Priority
+    capability_profile: CapabilityProfile
+    tool_allowlist: tuple[str, ...]
+    write_scope: tuple[str, ...]
+    write_owner_token: str
+    deadline_seconds: int
+    iteration_budget: int
+    dedupe_key: str
+    idempotent: bool
+    max_packet_tokens: int
+    max_result_chars: int
+    route: RoutePin = field(default_factory=RoutePin)
+
+    @classmethod
+    def from_spec(
+        cls,
+        spec: TaskSpec,
+        *,
+        run_id: str,
+        parent_session_id: str,
+        parent_turn_id: str,
+        generation: int = 1,
+        max_packet_tokens: int = 12000,
+        max_result_chars: int = DEFAULT_MAX_RESULT_CHARS,
+    ) -> "TaskPacket":
+        run_id = str(run_id or "").strip()
+        if not _TASK_ID_RE.fullmatch(run_id):
+            raise ContractError(
+                "run_id must be 1-64 ASCII letters, digits, dot, underscore, or hyphen"
+            )
+        effort = resolve_effort(spec)
+        iteration_budget = {
+            Effort.LOW: 8,
+            Effort.MEDIUM: 20,
+            Effort.HIGH: 40,
+            Effort.XHIGH: 60,
+            Effort.MAX: 60,
+        }[effort]
+        speed = resolve_speed(spec)
+        owner_material = (
+            f"{run_id}\0{spec.id}\0{generation}\0{stable_json_dumps(spec.write_scope)}"
+        )
+        owner = hashlib.sha256(owner_material.encode("utf-8")).hexdigest()
+        packet = cls(
+            run_id=run_id,
+            task_id=spec.id,
+            generation=generation,
+            parent_session_id=parent_session_id,
+            parent_turn_id=parent_turn_id,
+            objective=spec.goal,
+            context=spec.context,
+            acceptance=spec.acceptance,
+            dependencies=spec.depends_on,
+            required=spec.required,
+            kind=spec.kind,
+            effort=effort,
+            speed=speed,
+            priority=spec.priority,
+            capability_profile=spec.capability_profile,
+            tool_allowlist=tuple(
+                sorted(CAPABILITY_TOOL_ALLOWLISTS[spec.capability_profile])
+            ),
+            write_scope=spec.write_scope,
+            write_owner_token=owner,
+            # Maximum reasoning has the highest per-call cost. Bound wall time
+            # more tightly than other tiers so one worker cannot monopolize a
+            # scarce host-global lease for the task's full requested deadline.
+            deadline_seconds=min(spec.deadline_seconds, 180)
+            if effort is Effort.MAX
+            else spec.deadline_seconds,
+            iteration_budget=iteration_budget,
+            dedupe_key=spec.dedupe_key,
+            idempotent=spec.idempotent,
+            max_packet_tokens=max_packet_tokens,
+            max_result_chars=max_result_chars,
+        )
+        # Use Hermes' canonical estimator so CJK/code-heavy packets receive
+        # the same conservative accounting as direct Codex requests.
+        from agent.model_metadata import estimate_tokens_rough
+
+        estimate = max(1, int(estimate_tokens_rough(packet.worker_prompt())))
+        if estimate > max_packet_tokens:
+            raise ContractError(
+                f"task packet for {spec.id!r} is approximately {estimate} tokens; limit is {max_packet_tokens}"
+            )
+        return packet
+
+    def worker_prompt(self) -> str:
+        static = (
+            "You are a focused Hermes worker. Execute exactly one trusted task packet. "
+            "Do not widen scope, delegate, change route, or claim unverified effects. "
+            "Only allowed_tools are permitted. Missing tools: return needs_parent_decision "
+            "promptly. Shell/tests require parent execution; never bypass restrictions "
+            "through GUI/browser/MCP. "
+            "Return exactly this typed JSON shape: "
+            '{"status":"pass","answer":"string","evidence":["string"],'
+            '"artifacts":[],"checks":[],"uncertainties":["string"],'
+            '"suggested_followups":["string"]}. '
+            "Statuses: pass, needs_parent_decision, retryable_failure, terminal_failure. "
+            "All fields required; use [] when empty. For read-only inspection, checks "
+            "must be empty; passed checks need host evidence. JSON must fit "
+            "max_result_chars in characters and UTF-8 bytes. "
+            "Synthesize; never dump raw logs, unfiltered tool output, or duplicate "
+            "evidence. If content cannot fit, return a high-value subset with "
+            "needs_parent_decision and list omissions in uncertainties."
+        )
+        dynamic = {
+            "run_id": self.run_id,
+            "task_id": self.task_id,
+            "generation": self.generation,
+            "objective": self.objective,
+            "context": self.context,
+            "acceptance": self.acceptance,
+            "constraints": {
+                "capability_profile": self.capability_profile,
+                "allowed_tools": self.tool_allowlist,
+                "write_scope": self.write_scope,
+                "deadline_seconds": self.deadline_seconds,
+                "max_result_chars": self.max_result_chars,
+            },
+        }
+        return f"{static}\n\nTASK_PACKET\n{stable_json_dumps(dynamic)}"
+
