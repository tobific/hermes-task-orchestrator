+def resolve_effort(spec: TaskSpec) -> Effort:
+    if spec.effort is not Effort.AUTO:
+        return spec.effort
+    if spec.kind in {TaskKind.EXTRACT, TaskKind.INSPECT, TaskKind.SUMMARIZE}:
+        return Effort.LOW
+    if spec.kind in {TaskKind.EXECUTE, TaskKind.EDIT, TaskKind.TEST}:
+        return Effort.MEDIUM
+    return Effort.HIGH
+
+
+def resolve_speed(spec: TaskSpec) -> Speed:
+    if spec.speed is not Speed.AUTO:
+        return spec.speed
+    return Speed.STANDARD
+
+
+def normalize_task_graph(values: Sequence[Mapping[str, Any]]) -> tuple[TaskSpec, ...]:
+    tasks = tuple(
+        TaskSpec.from_dict(value, index=index) for index, value in enumerate(values)
+    )
+    if not tasks:
+        raise ContractError("task graph is empty")
+    by_id: dict[str, TaskSpec] = {}
+    dedupe: dict[str, TaskSpec] = {}
+    for task in tasks:
+        if task.id in by_id:
+            raise ContractError(f"duplicate task id: {task.id}")
+        by_id[task.id] = task
+        if task.dedupe_key:
+            previous = dedupe.get(task.dedupe_key)
+            if previous is not None and stable_json_dumps(
+                previous
+            ) != stable_json_dumps(task):
+                raise ContractError(
+                    f"dedupe_key {task.dedupe_key!r} describes different tasks"
+                )
+            dedupe[task.dedupe_key] = task
+    for task in tasks:
+        for dep in task.depends_on:
+            if dep not in by_id:
+                raise ContractError(f"task {task.id!r} has unknown dependency {dep!r}")
+            if dep == task.id:
+                raise ContractError(f"dependency cycle includes {task.id!r}")
+
+    visiting: set[str] = set()
+    visited: set[str] = set()
+
+    def visit(task_id: str) -> None:
+        if task_id in visited:
+            return
+        if task_id in visiting:
+            raise ContractError(f"dependency cycle includes {task_id!r}")
+        visiting.add(task_id)
+        for dep in by_id[task_id].depends_on:
+            visit(dep)
+        visiting.remove(task_id)
+        visited.add(task_id)
+
+    for task in tasks:
+        visit(task.id)
+
+    def depends_transitively(task_id: str, possible_ancestor: str) -> bool:
+        pending = list(by_id[task_id].depends_on)
+        seen: set[str] = set()
+        while pending:
+            current = pending.pop()
+            if current == possible_ancestor:
+                return True
+            if current not in seen:
+                seen.add(current)
+                pending.extend(by_id[current].depends_on)
+        return False
+
+    for index, left in enumerate(tasks):
+        if not left.write_scope:
+            continue
+        for right in tasks[index + 1 :]:
+            if not right.write_scope or not write_scopes_overlap(
+                left.write_scope, right.write_scope
+            ):
+                continue
+            if not (
+                depends_transitively(left.id, right.id)
+                or depends_transitively(right.id, left.id)
+            ):
+                raise ContractError(
+                    f"tasks {left.id!r} and {right.id!r} have overlapping write scopes without dependency ordering"
+                )
+    return tasks
