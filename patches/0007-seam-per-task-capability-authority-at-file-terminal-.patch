+@dataclass(frozen=True)
+class WorkerCheck:
+    name: str
+    status: str
+    detail: str = ""
+
+
+@dataclass(frozen=True)
+class ArtifactClaim:
+    path: str = ""
+    url: str = ""
+    sha256: str = ""
+
+
+@dataclass(frozen=True)
+class WorkerResult:
+    status: WorkerStatus
+    answer: str
+    evidence: tuple[str, ...] = ()
+    artifacts: tuple[ArtifactClaim, ...] = ()
+    checks: tuple[WorkerCheck, ...] = ()
+    uncertainties: tuple[str, ...] = ()
+    suggested_followups: tuple[str, ...] = ()
+
+    @classmethod
+    def from_dict(cls, value: Mapping[str, Any]) -> "WorkerResult":
+        if not isinstance(value, Mapping):
+            raise ContractError("worker result must be an object")
+        required_fields = {
+            "status",
+            "answer",
+            "evidence",
+            "artifacts",
+            "checks",
+            "uncertainties",
+            "suggested_followups",
+        }
+        missing = sorted(required_fields - set(value))
+        if missing:
+            raise ContractError(
+                f"worker result missing required fields: {', '.join(missing)}"
+            )
+
+        def string_list(name: str) -> tuple[str, ...]:
+            raw = value.get(name)
+            if not isinstance(raw, list) or not all(
+                isinstance(item, str) for item in raw
+            ):
+                raise ContractError(f"worker result {name} must be an array of strings")
+            return tuple(raw)
+
+        raw_status = str(value.get("status") or "").strip().lower()
+        # Host execution uses "completed" while WorkerResult uses the semantic
+        # success state "pass". Accept the host's natural success word at this
+        # contract boundary, then serialize only the canonical worker status.
+        if raw_status == HostExecutionStatus.COMPLETED.value:
+            raw_status = WorkerStatus.PASS.value
+        status = _enum(WorkerStatus, raw_status, WorkerStatus.TERMINAL_FAILURE)
+        answer = str(value.get("answer") or "").strip()
+        if not answer:
+            raise ContractError("worker result answer is required")
+        checks: list[WorkerCheck] = []
+        raw_checks = value.get("checks")
+        if not isinstance(raw_checks, list):
+            raise ContractError("worker result checks must be an array")
+        for raw in raw_checks:
+            if isinstance(raw, str) and raw.strip():
+                # Low-effort workers sometimes put read/analysis notes in the
+                # checks list despite the typed prompt. Preserve the note but
+                # mark it skipped so it never masquerades as host verification.
+                checks.append(WorkerCheck("worker_note", "skipped", raw.strip()))
+                continue
+            if not isinstance(raw, Mapping) or not str(raw.get("name") or "").strip():
+                raise ContractError("worker result checks require a name")
+            check_status = str(raw.get("status") or "").strip().lower()
+            if check_status not in {"pass", "fail", "skipped"}:
+                raise ContractError(
+                    "worker result check status must be pass, fail, or skipped"
+                )
+            checks.append(
+                WorkerCheck(
+                    str(raw["name"]), check_status, str(raw.get("detail") or "")
+                )
+            )
+        artifacts: list[ArtifactClaim] = []
+        raw_artifacts = value.get("artifacts")
+        if not isinstance(raw_artifacts, list):
+            raise ContractError("worker result artifacts must be an array")
+        for raw in raw_artifacts:
+            if isinstance(raw, str):
+                if raw.startswith(("https://", "http://")):
+                    artifacts.append(ArtifactClaim(url=raw))
+                else:
+                    artifacts.append(ArtifactClaim(path=raw))
+            elif isinstance(raw, Mapping):
+                path = str(raw.get("path") or "").strip()
+                url = str(raw.get("url") or "").strip()
+                digest = str(raw.get("sha256") or "").strip().lower()
+                if bool(path) == bool(url):
+                    raise ContractError(
+                        "artifact claim requires exactly one of path or url"
+                    )
+                artifacts.append(ArtifactClaim(path=path, url=url, sha256=digest))
+            else:
+                raise ContractError(
+                    "worker result artifacts must be strings or objects"
+                )
+        return cls(
+            status=status,
+            answer=answer,
+            evidence=string_list("evidence"),
+            artifacts=tuple(artifacts),
+            checks=tuple(checks),
+            uncertainties=string_list("uncertainties"),
+            suggested_followups=string_list("suggested_followups"),
+        )
+
