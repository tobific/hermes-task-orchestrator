+# Approved external coordinator ownership and capability state.
+@dataclass(frozen=True)
+class DelegationIdentity:
+    run_id: str = ""
+    task_id: str = ""
+    generation: int = 0
+    write_owner_token: str = ""
+    write_scope: tuple[str, ...] = ()
+    capability_profile: str = ""
+
+
