@@ -0,0 +1,104 @@
+"""Cron agent construction, separate from scheduling and delivery."""
+
+from __future__ import annotations
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from cron.scheduler import _CronAgentSetup
+
+
+def construct_cron_agent(
+    AIAgent,
+    job: dict,
+    _cfg: dict,
+    setup: _CronAgentSetup,
+    *,
+    workdir,
+    session_id,
+    session_db,
+    skip_background_review=True,
+):
+    from cron.scheduler import (
+        _resolve_cron_enabled_toolsets,
+        _resolve_cron_disabled_toolsets,
+    )
+
+    from cron.jobs import _normalize_job_service_tier, _normalize_job_allow_fallbacks
+
+    tier = _normalize_job_service_tier(job.get("service_tier"))
+    allow_fallbacks = _normalize_job_allow_fallbacks(job.get("allow_fallbacks"))
+    tier_kwargs = (
+        {}
+        if tier is None
+        else {"service_tier": "priority" if tier == "priority" else None}
+    )
+    runtime = setup.runtime
+    request_overrides = runtime.get("request_overrides")
+    if tier is not None:
+        request_overrides = dict(request_overrides or {})
+        for key in ("service_tier", "speed"):
+            request_overrides.pop(key, None)
+        if isinstance(request_overrides.get("extra_body"), dict):
+            body = dict(request_overrides["extra_body"])
+            for key in ("service_tier", "speed"):
+                body.pop(key, None)
+            request_overrides["extra_body"] = body
+        if tier == "priority":
+            from hermes_cli.models import resolve_fast_mode_overrides
+
+            fast = resolve_fast_mode_overrides(
+                setup.model,
+                provider=runtime.get("provider"),
+                base_url=runtime.get("base_url"),
+            )
+            if not fast:
+                raise ValueError(
+                    "Cron service_tier priority is unsupported by the selected route"
+                )
+            request_overrides.update(fast)
+    pr = _cfg.get("provider_routing") or {}
+    agent = AIAgent(
+        model=setup.model,
+        api_key=runtime.get("api_key"),
+        base_url=runtime.get("base_url"),
+        provider=runtime.get("provider"),
+        requested_provider=runtime.get("requested_provider"),
+        api_mode=runtime.get("api_mode"),
+        request_overrides=request_overrides,
+        acp_command=runtime.get("command"),
+        acp_args=runtime.get("args"),
+        max_iterations=setup.max_iterations,
+        reasoning_config=setup.reasoning_config,
+        prefill_messages=setup.prefill_messages,
+        fallback_model=[] if allow_fallbacks is False else setup.fallback_model,
+        **tier_kwargs,
+        credential_pool=setup.credential_pool,
+        providers_allowed=pr.get("only"),
+        providers_ignored=pr.get("ignore"),
+        providers_order=pr.get("order"),
+        provider_sort=pr.get("sort"),
+        openrouter_min_coding_score=(_cfg.get("openrouter") or {}).get(
+            "min_coding_score"
+        ),
+        enabled_toolsets=_resolve_cron_enabled_toolsets(job, _cfg),
+        disabled_toolsets=_resolve_cron_disabled_toolsets(_cfg),
+        quiet_mode=True,
+        # Project context files only with a configured workdir; SOUL.md always.
+        skip_context_files=not bool(workdir),
+        load_soul_identity=True,
+        skip_memory=True,
+        skip_background_review=skip_background_review,
+        platform="cron",
+        session_id=session_id,
+        session_db=session_db,
+    )
+
+    from agent.service_tier_policy import capture_request_owner
+
+    capture_request_owner(
+        agent,
+        kind="cron",
+        identity=str(job.get("id") or ""),
+        job_name=str(job.get("name") or ""),
+    )
+    return agent
